# Copie para .env.local. Todas as variáveis são opcionais: o site funciona sem nenhuma.

# Formulário de contato (EmailJS, https://www.emailjs.com/). Sem as três, a página de contato
# mostra só o seu e-mail, que abre o programa de e-mail de quem visita.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4, no formato G-XXXXXXXXXX. Sem ela, nenhum script do Google é carregado.
# Dica: defina só no ambiente de Production da Vercel para não contar seus próprios acessos.
NEXT_PUBLIC_GA_ID=
